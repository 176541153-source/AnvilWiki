---
/**
 * HomePage — renders the homepage from the locale JSON `home` namespace.
 *
 * Data-driven: changing src/locales/en.json updates the homepage without
 * touching this component.
 *
 * Sections (top to bottom):
 *   1. Hero          — title, description, CTAs (strong visual anchor)
 *   2. QuickStart    — 4 large icon cards (Codes / Bosses / Guides / Tier)
 *   3. Diagnose      — optional problem-to-next-action cards
 *   4. Recent Updates + Trending links (two columns)
 *   5. Explore       — content modules with displayTypes
 *   6. ClosingCta    — bottom call-to-action
 *
 * v0.2 refactor: trimmed from 8 sections to 5. Removed GameInfo (info
 * duplicated Hero stats), FAQ (moved to /faq), standalone TrendingNow
 * (merged into Recent Updates). Explore modules trimmed 8→4. Page length
 * compressed from ~7 screens to ~4.
 */
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import VideoSection from '~/components/home/VideoSection.astro';
import QuickStart from '~/components/home/QuickStart.astro';
import ExploreModules from '~/components/home/ExploreModules.astro';
import { site } from '~/config/site';
import { NAVIGATION_CONFIG } from '~/config/navigation';
import { type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { getRecentEntries, parseEntryId } from '~/lib/content';
import { localizePath, detailPath, recentPath } from '~/lib/url';

interface Props {
  locale: Locale;
  jsonLd?: Record<string, unknown>[];
  /** hreflang alternates (built by the route page). */
  alternates?: Array<{ hreflang: string; href: string }>;
}
const { locale, jsonLd = [], alternates = [] } = Astro.props;
const ui = getUi(locale);
const home = ui.home as any;
const nav = ui.nav as Record<string, string>;
const shared = ui.shared as unknown as Record<string, any>;

const recent = await getRecentEntries(locale, 6);

const meta = home.meta ?? { title: site.name, description: site.description };
const hero = home.hero ?? {};
// Shape-only defaults: getUi() deep-merges over en.json, so titles/labels are
// guaranteed present — no hardcoded English fallbacks (UI text lives in the
// locale JSON per the template's own rule).
const updates = home.updates ?? {};
const start = home.start ?? { cards: [] };
const diagnose = home.diagnose ?? { cards: [] };
const popular = home.popular ?? { quickLinks: [] };
const explore = home.explore ?? { modules: [] };
const closingCta = home.closingCta ?? {};
const heroQuickActions = Array.isArray(hero.quickActions) ? hero.quickActions : [];
const heroSignals = Array.isArray(hero.signals) ? hero.signals : [];

function actionHref(href: string | undefined, fallback: string): string {
  const target = href || fallback;
  return /^(?:[a-z][a-z0-9+.-]*:|\/\/|#)/i.test(target) ? target : localizePath(target, locale);
}

function isExternalHref(href: string): boolean {
  return /^(?:https?:)?\/\//i.test(href);
}

const primaryHref = actionHref(hero.ctaPrimaryHref, site.social.official);
const secondaryHref = actionHref(
  hero.ctaSecondaryHref,
  `/${NAVIGATION_CONFIG[0]?.key ?? 'guides'}`,
);
const tertiaryHref = actionHref(hero.ctaTertiaryHref, site.social.official);
const showHeroPanel = Boolean(hero.panel) || heroQuickActions.length > 0;

// QuickLink may be a string or { label, href } — normalize for the sidebar list.
type QuickLink = string | { label: string; href: string };
const trendingLinks: QuickLink[] = Array.isArray(popular.quickLinks) ? popular.quickLinks : [];
function trendingHref(link: QuickLink): string | null {
  return typeof link === 'string' ? null : localizePath(link.href, locale);
}
function trendingLabel(link: QuickLink): string {
  return typeof link === 'string' ? link : link.label;
}
---

<LocaleLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  alternates={alternates}
  jsonLd={jsonLd}
>
  {/* ─────────────────────────────── Hero ─────────────────────────────── */}
  <section class="relative overflow-hidden border-b border-border">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-gradient-to-br from-nav/10 via-background to-background"
    >
    </div>
    <div
      class:list={[
        'relative mx-auto grid w-full max-w-7xl items-center gap-10 px-4 py-12 lg:py-16',
        showHeroPanel
          ? 'min-h-[38rem] lg:grid-cols-[minmax(0,1fr)_minmax(22rem,0.86fr)]'
          : 'min-h-[32rem]',
      ]}
    >
      <div class="max-w-2xl">
        <p
          class="inline-flex items-center gap-2 rounded-full border border-nav/30 bg-nav/10 px-3 py-1 text-xs font-semibold text-foreground"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-nav" aria-hidden="true"></span>
          {hero.badge}
        </p>
        <h1
          class="mt-5 text-4xl font-black tracking-[-0.035em] text-foreground sm:text-5xl lg:text-6xl"
        >
          {hero.title}
        </h1>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-muted-foreground md:text-lg">
          {hero.description}
        </p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          {
            hero.ctaPrimary && (
              <a
                href={primaryHref}
                target={isExternalHref(primaryHref) ? '_blank' : undefined}
                rel={isExternalHref(primaryHref) ? 'noopener noreferrer' : undefined}
                class="btn-primary min-h-11 gap-2 px-5"
              >
                <Icon name={hero.ctaPrimaryIcon ?? 'lucide:arrow-right'} class="h-4 w-4" />
                {hero.ctaPrimary}
              </a>
            )
          }
          {
            hero.ctaSecondary && (
              <a
                href={secondaryHref}
                target={isExternalHref(secondaryHref) ? '_blank' : undefined}
                rel={isExternalHref(secondaryHref) ? 'noopener noreferrer' : undefined}
                class="btn-outline min-h-11 gap-2 px-5"
              >
                <Icon name={hero.ctaSecondaryIcon ?? 'lucide:book-open'} class="h-4 w-4" />
                {hero.ctaSecondary}
              </a>
            )
          }
          {
            hero.ctaTertiary && (
              <a
                href={tertiaryHref}
                target={isExternalHref(tertiaryHref) ? '_blank' : undefined}
                rel={isExternalHref(tertiaryHref) ? 'noopener noreferrer' : undefined}
                class="inline-flex min-h-11 items-center justify-center gap-2 px-2 text-sm font-medium text-foreground hover:text-nav"
              >
                {hero.ctaTertiary}
                <Icon name={hero.ctaTertiaryIcon ?? 'lucide:external-link'} class="h-3.5 w-3.5" />
              </a>
            )
          }
        </div>
        {
          heroSignals.length > 0 && (
            <dl class="mt-8 grid max-w-xl grid-cols-3 divide-x divide-border border-y border-border py-3">
              {heroSignals.map((signal: { value: string; label: string }) => (
                <div class="px-3 first:pl-0">
                  <dt class="text-xs text-muted-foreground">{signal.label}</dt>
                  <dd class="mt-0.5 text-sm font-bold text-foreground">{signal.value}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>

      {
        showHeroPanel && (
          <div class="lg:pl-4">
            <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-2xl shadow-nav/10">
              <div class="relative aspect-[16/10] overflow-hidden">
                <img
                  src={hero.panel?.imageSrc ?? '/images/hero.webp'}
                  alt={hero.panel?.imageAlt ?? site.name}
                  width={site.ogImageWidth}
                  height={site.ogImageHeight}
                  fetchpriority="high"
                  class="h-full w-full object-cover"
                />
                <div
                  aria-hidden="true"
                  class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/10 to-transparent"
                />
                {hero.panel && (
                  <div class="absolute inset-x-0 bottom-0 p-5 text-white">
                    {hero.panel.eyebrow && (
                      <p class="text-xs font-semibold uppercase tracking-wider text-white/70">
                        {hero.panel.eyebrow}
                      </p>
                    )}
                    <p class="mt-1 text-xl font-bold leading-tight">{hero.panel.title}</p>
                    <p class="mt-1 max-w-md text-sm text-white/75">{hero.panel.description}</p>
                  </div>
                )}
              </div>
              {heroQuickActions.length > 0 && (
                <div class="grid divide-y divide-border sm:grid-cols-3 sm:divide-x sm:divide-y-0">
                  {heroQuickActions.map(
                    (action: { title: string; detail: string; href: string; icon: string }) => {
                      const href = actionHref(action.href, '/');
                      return (
                        <a
                          href={href}
                          target={isExternalHref(href) ? '_blank' : undefined}
                          rel={isExternalHref(href) ? 'noopener noreferrer' : undefined}
                          class="group flex items-start gap-2 p-4 transition hover:bg-muted/70"
                        >
                          <Icon name={action.icon} class="mt-0.5 h-4 w-4 shrink-0 text-nav" />
                          <span class="min-w-0">
                            <span class="block text-xs font-bold text-foreground group-hover:text-nav">
                              {action.title}
                            </span>
                            <span class="mt-0.5 block text-[0.7rem] leading-snug text-muted-foreground">
                              {action.detail}
                            </span>
                          </span>
                        </a>
                      );
                    },
                  )}
                </div>
              )}
            </div>
          </div>
        )
      }
    </div>
  </section>

  {/* Trailer — only renders when a videoId is configured. */}
  {hero.videoId && <VideoSection videoId={hero.videoId} title={`${site.game.name} trailer`} />}

  {/* ───────────────────────────── Quick Start ────────────────────────── */}
  <QuickStart locale={locale} badge={start.badge} title={start.title} cards={start.cards} />

  {/* ─────────────────────── Problem-to-action routes ─────────────────────── */}
  {
    Array.isArray(diagnose.cards) && diagnose.cards.length > 0 && (
      <section class="border-t border-border bg-muted/35">
        <div class="section">
          <p class="text-sm font-semibold uppercase tracking-wider text-nav">{diagnose.badge}</p>
          <div class="mt-1 max-w-2xl">
            <h2 class="text-2xl font-bold md:text-3xl">{diagnose.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{diagnose.description}</p>
          </div>
          <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            {diagnose.cards.map(
              (card: { symptom: string; action: string; href: string; icon: string }) => {
                const href = actionHref(card.href, '/');
                return (
                  <a
                    href={href}
                    target={isExternalHref(href) ? '_blank' : undefined}
                    rel={isExternalHref(href) ? 'noopener noreferrer' : undefined}
                    class="group flex min-h-40 flex-col rounded-xl border border-border bg-card p-5 transition hover:-translate-y-0.5 hover:border-nav/60 hover:shadow-lg"
                  >
                    <Icon name={card.icon} class="h-5 w-5 text-nav" />
                    <h3 class="mt-4 text-base font-bold leading-snug text-foreground">
                      {card.symptom}
                    </h3>
                    <span class="mt-auto flex items-center gap-1.5 pt-4 text-sm font-semibold text-nav">
                      {card.action}
                      <Icon
                        name="lucide:arrow-right"
                        class="h-4 w-4 transition group-hover:translate-x-0.5"
                      />
                    </span>
                  </a>
                );
              },
            )}
          </div>
        </div>
      </section>
    )
  }

  {/* ───────────────────── Recent Updates + Trending ───────────────────── */}
  <section class="section border-t border-border">
    <div class="grid gap-8 lg:grid-cols-3">
      {/* Recent updates — 2/3 width on desktop. */}
      <div class="lg:col-span-2">
        <div class="flex items-baseline justify-between">
          <h2 class="text-2xl font-bold">{updates.title}</h2>
          <a
            href={recentPath(locale)}
            class="text-sm text-foreground hover:text-nav hover:underline">{shared.browseAll}</a
          >
        </div>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {
            recent.length === 0 ? (
              <p class="text-sm text-muted-foreground">{shared.noArticles}</p>
            ) : (
              recent.map((entry) => {
                const parsed = parseEntryId(entry.id);
                if (!parsed) return null;
                return (
                  <a href={detailPath(parsed.category, parsed.slug, locale)} class="card p-4">
                    <p class="text-xs uppercase tracking-wider text-muted-foreground">
                      {nav[parsed.category] ?? parsed.category}
                    </p>
                    <h3 class="mt-1 font-semibold leading-snug">{entry.data.title}</h3>
                    <p class="mt-1 line-clamp-2 text-sm text-muted-foreground">
                      {entry.data.description}
                    </p>
                  </a>
                );
              })
            )
          }
        </div>
      </div>

      {/* Trending — 1/3 width sidebar list. */}
      {
        trendingLinks.length > 0 && (
          <aside>
            <p class="text-sm font-semibold uppercase tracking-wider text-foreground">
              {popular.badge}
            </p>
            <h2 class="mt-1 text-2xl font-bold">{popular.title}</h2>
            <ul class="mt-4 space-y-2">
              {trendingLinks.map((link: QuickLink) => {
                const href = trendingHref(link);
                const label = trendingLabel(link);
                return (
                  <li>
                    {href ? (
                      <a
                        href={href}
                        class="flex items-center gap-2 rounded-md border bg-card p-3 text-sm font-medium transition hover:border-nav/50"
                      >
                        <Icon name="lucide:trending-up" class="h-4 w-4 shrink-0 text-nav" />
                        <span class="leading-snug">{label}</span>
                      </a>
                    ) : (
                      <div class="flex items-center gap-2 rounded-md border bg-card p-3 text-sm font-medium">
                        <Icon name="lucide:trending-up" class="h-4 w-4 shrink-0 text-nav" />
                        <span class="leading-snug">{label}</span>
                      </div>
                    )}
                  </li>
                );
              })}
            </ul>
          </aside>
        )
      }
    </div>
  </section>

  {/* ──────────────────────────── Explore Modules ─────────────────────── */}
  {
    explore.modules?.length > 0 && (
      <section class="section border-t border-border">
        <h2 class="text-2xl font-bold">{explore.title}</h2>
        <p class="mt-1 text-sm text-muted-foreground">{explore.description}</p>
        <div class="mt-8">
          <ExploreModules modules={explore.modules} locale={locale} />
        </div>
      </section>
    )
  }

  {/* ─────────────────────────────── Final CTA ────────────────────────── */}
  {
    closingCta.title && (
      <section class="section border-t border-border">
        <div class="rounded-xl border bg-card p-8 text-center md:p-12">
          <h2 class="text-2xl font-bold md:text-3xl">{closingCta.title}</h2>
          <p class="mx-auto mt-2 max-w-xl text-muted-foreground">{closingCta.description}</p>
          <div class="mt-6 flex justify-center gap-3">
            <a
              href={actionHref(closingCta.primaryHref, site.social.official)}
              target={
                isExternalHref(actionHref(closingCta.primaryHref, site.social.official))
                  ? '_blank'
                  : undefined
              }
              rel={
                isExternalHref(actionHref(closingCta.primaryHref, site.social.official))
                  ? 'noopener noreferrer'
                  : undefined
              }
              class="btn-primary"
            >
              {closingCta.primary}
            </a>
            {closingCta.secondary && (closingCta.secondaryHref || site.social.discord) && (
              <a
                href={actionHref(closingCta.secondaryHref, site.social.discord ?? '/')}
                target={
                  isExternalHref(actionHref(closingCta.secondaryHref, site.social.discord ?? '/'))
                    ? '_blank'
                    : undefined
                }
                rel={
                  isExternalHref(actionHref(closingCta.secondaryHref, site.social.discord ?? '/'))
                    ? 'noopener noreferrer'
                    : undefined
                }
                class="btn-outline"
              >
                {closingCta.secondary}
              </a>
            )}
          </div>
        </div>
      </section>
    )
  }
</LocaleLayout>
