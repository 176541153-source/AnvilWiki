---
/**
 * AdSenseSlot — renders a Google AdSense ad unit.
 *
 * Requires `PUBLIC_ADSENSE_CLIENT` (your AdSense publisher ID, e.g.
 * ca-pub-XXXXXXXXXXXXXXXX). When empty, the component renders nothing.
 *
 * The AdSense loader script is injected once in BaseLayout.astro `<head>`.
 * Each slot just drops an `<ins class="adsbygoogle">` tag and pushes to the
 * `adsbygoogle` queue.
 *
 * Usage:
 *   <AdSenseSlot slot="1234567890" />
 *   <AdSenseSlot slot="1234567890" format="fluid" responsive={true} />
 */
interface Props {
  /** AdSense slot ID (from your AdSense dashboard). */
  slot: string;
  /** Ad format: "auto" (default) or "fluid". */
  format?: 'auto' | 'fluid';
  /** Enable full-width responsive ads. Default true. */
  responsive?: boolean;
  /** Optional CSS class for layout. */
  class?: string;
}

const { slot, format = 'auto', responsive = true, class: className = '' } = Astro.props;
const client = import.meta.env.PUBLIC_ADSENSE_CLIENT;
---

{client && (
  <ins
    class={`adsbygoogle ${className}`.trim()}
    style="display:block"
    data-ad-client={client}
    data-ad-slot={slot}
    data-ad-format={format}
    data-full-width-responsive={responsive ? 'true' : 'false'}
  />
)}

{client && (
  <script is:inline>
    (window.adsbygoogle = window.adsbygoogle || []).push({});
  </script>
)}
