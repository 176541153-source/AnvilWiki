---
/**
 * HandbookHub — the /landing/docs index. Groups handbook chapters by manual
 * (learn / dev) into card lists. Pure props-driven; all copy lives in
 * landing.ts (t.handbook).
 */
import { Icon } from 'astro-icon/components';
import { type LandingContent } from '~/config/landing';
import { handbookPath, parseHandbookId, type HandbookEntry, type HandbookManual } from '~/lib/handbook';

interface Props {
  chapters: HandbookEntry[];
  locale: 'en' | 'zh';
  t: LandingContent;
}
const { chapters, locale, t } = Astro.props;
const manuals: HandbookManual[] = ['learn', 'dev'];
const manualIcons: Record<HandbookManual, string> = {
  learn: 'lucide:graduation-cap',
  dev: 'lucide:wrench',
};
---

<section class="section">
  <div class="mx-auto max-w-5xl">
    <h1 class="text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">
      {t.handbook.hubTitle}
    </h1>
    <p class="mx-auto mt-4 max-w-3xl text-muted-foreground">{t.handbook.hubSubtitle}</p>

    {/* The whole job at a glance — every step links to its chapter */}
    <div class="mt-10 rounded-lg border border-border bg-card p-5 sm:p-6">
      <h2 class="text-lg font-bold text-foreground">{t.handbook.roadmap.title}</h2>
      <p class="mt-1 text-sm text-muted-foreground">{t.handbook.roadmap.hint}</p>
      <ol class="mt-5 grid gap-2 sm:grid-cols-2">
        {t.handbook.roadmap.items.map((item, i) => (
          <li>
            <a
              href={item.href}
              class="group flex items-center gap-3 rounded-md px-2 py-1.5 transition hover:bg-muted"
            >
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-nav/10 text-xs font-bold text-nav">
                {i + 1}
              </span>
              <span class="min-w-0 flex-1 truncate text-sm text-foreground transition group-hover:text-nav">
                {item.label}
              </span>
              <span class="shrink-0 text-xs text-muted-foreground">{item.time}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>

    {manuals.map((manual) => (
      <div id={manual} class="mt-12 scroll-mt-20">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-nav/10 text-nav">
            <Icon name={manualIcons[manual]} class="h-5 w-5" />
          </div>
          <div>
            <h2 class="text-xl font-bold text-foreground">{t.handbook.manuals[manual].label}</h2>
            <p class="text-sm text-muted-foreground">{t.handbook.manuals[manual].description}</p>
          </div>
        </div>
        <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {chapters
            .filter((c) => c.data.manual === manual)
            .map((chapter) => (
              <a
                href={handbookPath(locale, parseHandbookId(chapter.id)?.slug ?? '')}
                class="card group flex flex-col p-5"
              >
                <div class="flex items-center justify-between">
                  <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-nav/10 text-nav">
                    <Icon name={chapter.data.icon} class="h-5 w-5" />
                  </div>
                  <span class="text-xs font-medium text-muted-foreground">
                    {t.handbook.chapterLabel}
                    {` `}
                    {chapter.data.order}
                    {t.handbook.chapterSuffix}
                  </span>
                </div>
                <h3 class="mt-3 font-semibold text-foreground">{chapter.data.title}</h3>
                <p class="mt-1 line-clamp-3 text-sm text-muted-foreground">
                  {chapter.data.description}
                </p>
                <span class="mt-3 inline-flex items-center gap-1 text-xs font-medium text-nav">
                  <span class="border-b border-transparent transition group-hover:border-nav">
                    {t.handbook.readLabel}
                  </span>
                  <Icon
                    name="lucide:arrow-right"
                    class="h-3 w-3 transition group-hover:translate-x-0.5"
                  />
                </span>
              </a>
            ))}
        </div>
      </div>
    ))}
  </div>
</section>
