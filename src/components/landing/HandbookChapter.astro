---
/**
 * HandbookChapter — the chapter page body for /landing/docs/[slug].
 * Renders breadcrumb, chapter meta (manual + order), TL;DR card, the prose
 * body (rendered by the route page), prev/next within the same manual, and
 * an "Edit on GitHub" link. All labels come from landing.ts (t.handbook).
 */
import { Icon } from 'astro-icon/components';
import { type LandingContent } from '~/config/landing';
import {
  handbookPath,
  handbookSourceUrl,
  parseHandbookId,
  type HandbookEntry,
  type HandbookLocale,
} from '~/lib/handbook';

interface Props {
  locale: HandbookLocale;
  chapter: HandbookEntry;
  t: LandingContent;
  prev: HandbookEntry | null;
  next: HandbookEntry | null;
}

const { locale, chapter, t, prev, next } = Astro.props;
const slug = parseHandbookId(chapter.id)?.slug ?? '';
const manualLabel = t.handbook.manuals[chapter.data.manual].label;
const chapterNo = `${t.handbook.chapterLabel} ${chapter.data.order}${t.handbook.chapterSuffix}`;
const updated = chapter.data.updated?.toLocaleDateString(locale === 'zh' ? 'zh-CN' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="section">
  <div class="mx-auto max-w-3xl">
    <!-- Breadcrumb: docs hub → manual → chapter -->
    <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground">
      <a href={handbookPath(locale, '', true)} class="transition hover:text-nav">
        {t.handbook.backToHub}
      </a>
      <Icon name="lucide:chevron-right" class="h-3.5 w-3.5" />
      <span>{manualLabel}</span>
      <Icon name="lucide:chevron-right" class="h-3.5 w-3.5" />
      <span aria-current="page" class="text-foreground">{chapterNo}</span>
    </nav>

    <header class="mt-6">
      <div class="flex flex-wrap items-center gap-3">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-nav/10 px-2.5 py-0.5 text-xs font-semibold text-nav">
          <Icon name={chapter.data.icon} class="h-3.5 w-3.5" />
          {chapterNo}
        </span>
        {updated && (
          <span class="text-xs text-muted-foreground">
            {t.handbook.updatedLabel} {updated}
          </span>
        )}
      </div>
      <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">
        {chapter.data.title}
      </h1>
      <p class="mt-3 text-lg text-muted-foreground">{chapter.data.description}</p>
    </header>

    {chapter.data.tldr && (
      <aside
        class="mt-6 rounded-lg border-l-4 border-nav bg-nav/5 px-4 py-3"
        aria-label={t.handbook.tldrLabel}
      >
        <p class="text-xs font-bold uppercase tracking-wide text-nav">{t.handbook.tldrLabel}</p>
        <p class="mt-1 text-sm leading-relaxed text-foreground/90">{chapter.data.tldr}</p>
      </aside>
    )}

    <div
      class="prose prose-lg mt-8 max-w-none dark:prose-invert prose-headings:scroll-mt-20 prose-a:text-nav"
    >
      <slot />
    </div>

    <!-- Chapter footer: prev / next within the same manual + edit link -->
    <footer class="mt-12 border-t border-border pt-6">
      <div class="grid gap-3 sm:grid-cols-2">
        {prev ? (
          <a
            href={handbookPath(locale, parseHandbookId(prev.id)?.slug ?? '')}
            class="card group flex flex-col gap-1 p-4"
          >
            <span class="text-xs font-medium text-muted-foreground">
              ← {t.handbook.prevLabel}
            </span>
            <span class="font-semibold text-foreground transition group-hover:text-nav">
              {prev.data.title}
            </span>
          </a>
        ) : (
          <span class="hidden sm:block"></span>
        )}
        {next && (
          <a
            href={handbookPath(locale, parseHandbookId(next.id)?.slug ?? '')}
            class="card group flex flex-col items-end gap-1 p-4 text-right"
          >
            <span class="text-xs font-medium text-muted-foreground">
              {t.handbook.nextLabel} →
            </span>
            <span class="font-semibold text-foreground transition group-hover:text-nav">
              {next.data.title}
            </span>
          </a>
        )}
      </div>
      <div class="mt-6 flex justify-between gap-4 text-sm">
        <a
          href={handbookPath(locale, '', true)}
          class="inline-flex items-center gap-1 text-muted-foreground transition hover:text-nav"
        >
          <Icon name="lucide:arrow-left" class="h-3.5 w-3.5" />
          {t.handbook.backToHub}
        </a>
        <a
          href={handbookSourceUrl(locale, slug)}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1 text-muted-foreground transition hover:text-nav"
        >
          <Icon name="lucide:pencil" class="h-3.5 w-3.5" />
          {t.handbook.editLabel}
        </a>
      </div>
    </footer>
  </div>
</article>
