---
/**
 * CommunitySites — real sites built with AnvilWiki by the community.
 * Site data lives in COMMUNITY_SITES (src/config/landing.ts) so the list
 * stays locale-independent; section copy comes from t.builtWith.
 */
import { Icon } from 'astro-icon/components';
import { type LandingContent, COMMUNITY_SITES } from '~/config/landing';

interface Props {
  t: LandingContent;
}
const { t } = Astro.props;
const locale = t.htmlLang;
const sites = COMMUNITY_SITES.map((site) => ({
  ...site,
  description: locale === 'zh' ? site.descriptionZh : site.descriptionEn,
}));
---

<section class="section border-t border-border">
  <div class="mx-auto max-w-5xl">
    <h2 class="text-center text-3xl font-extrabold tracking-tight text-foreground">
      {t.builtWith.title}
    </h2>
    <p class="mx-auto mt-2 max-w-2xl text-center text-muted-foreground">
      {t.builtWith.subtitle}
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {sites.map((site) => (
        <a
          href={site.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-xl border border-border bg-card p-5 shadow-sm transition hover:border-primary/40 hover:shadow-md"
        >
          <div class="flex items-center justify-between gap-2">
            <h3 class="font-bold text-foreground">{site.name}</h3>
            <Icon
              name="lucide:external-link"
              class="h-4 w-4 flex-shrink-0 text-muted-foreground transition group-hover:text-primary"
            />
          </div>
          <p class="mt-1 inline-flex items-center gap-1 rounded-full bg-muted px-2.5 py-0.5 text-xs text-muted-foreground">
            <Icon name="lucide:gamepad-2" class="h-3 w-3" />
            {site.game}
          </p>
          <p class="mt-3 text-sm leading-relaxed text-foreground/80">{site.description}</p>
          <p class="mt-3 truncate text-xs text-muted-foreground">{site.url.replace('https://', '').replace(/\/$/, '')}</p>
        </a>
      ))}
    </div>
    <div class="mt-6 text-center">
      <a
        href={t.builtWith.submitHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:underline"
      >
        {t.builtWith.submitLabel}
      </a>
    </div>
  </div>
</section>
