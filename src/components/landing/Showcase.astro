---
/**
 * Showcase — demo preview section.
 * MVP: text + bullet points (screenshots to be added later).
 * Links to the live demo at /.
 */
import { Icon } from 'astro-icon/components';
import { landing } from '~/config/landing';
---

<section class="section border-t border-border bg-muted/30">
  <div class="mx-auto grid max-w-5xl items-center gap-8 lg:grid-cols-2">
    {/* Left: text */}
    <div>
      <h2 class="text-3xl font-extrabold tracking-tight text-foreground">
        {landing.showcase.title}
      </h2>
      <p class="mt-2 text-muted-foreground">{landing.showcase.subtitle}</p>
      <ul class="mt-5 space-y-3">
        {landing.showcase.points.map((point) => (
          <li class="flex items-start gap-2 text-sm text-foreground/80">
            <Icon name="lucide:check-circle-2" class="mt-0.5 h-4 w-4 flex-shrink-0 text-green-600 dark:text-green-400" />
            <span>{point}</span>
          </li>
        ))}
      </ul>
      <a
        href={landing.showcase.cta.href}
        class="btn-primary mt-6 inline-flex items-center gap-1.5"
      >
        {landing.showcase.cta.label}
      </a>
    </div>

    {/* Right: real screenshots — article page (desktop) + homepage (mobile) */}
    <div class="space-y-4">
      <div class="overflow-hidden rounded-xl border border-border bg-card shadow-lg">
        <div class="flex items-center gap-2 border-b border-border bg-muted px-4 py-2.5">
          <span class="h-2.5 w-2.5 rounded-full bg-red-400"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-yellow-400"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-green-400"></span>
          <span class="ml-3 truncate rounded bg-background px-3 py-0.5 text-xs text-muted-foreground">
            anvilwiki.pages.dev/bosses/emberfang
          </span>
        </div>
        <img
          src="/images/showcase/demo-article.png"
          alt="Boss guide article — Quick Answer card and structured Boss Overview data card"
          width="1280"
          height="800"
          loading="lazy"
          decoding="async"
          class="w-full"
        />
      </div>
      <div class="flex items-end justify-center gap-4">
        <img
          src="/images/showcase/demo-mobile.png"
          alt="Mobile view of the demo homepage"
          width="195"
          height="360"
          loading="lazy"
          decoding="async"
          class="w-32 rounded-lg border border-border shadow-md sm:w-40"
        />
        <p class="max-w-40 text-xs text-muted-foreground">
          Mobile-first: clean first screen, scrollable tables, tap-to-copy codes.
        </p>
      </div>
    </div>
  </div>
</section>
