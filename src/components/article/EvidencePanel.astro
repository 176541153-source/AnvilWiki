---
/**
 * Visible source and verification summary for evidence-sensitive articles.
 *
 * Data comes exclusively from frontmatter `evidence`; the component never
 * invents a status or source. ArticlePage only renders it when that object is
 * present, so existing forks remain backward compatible.
 */
import { Icon } from 'astro-icon/components';

type EvidenceStatus = 'official' | 'verified' | 'mixed' | 'community' | 'unconfirmed';
type SourceKind = 'official' | 'primary' | 'secondary' | 'community';

interface Source {
  label: string;
  url: string;
  kind: SourceKind;
}

interface Evidence {
  status: EvidenceStatus;
  checkedAt: Date;
  sources: Source[];
}

interface Props {
  evidence: Evidence;
  locale: string;
  labels?: {
    title?: string;
    checkedAt?: string;
    statuses?: Partial<Record<EvidenceStatus, string>>;
    sourceKinds?: Partial<Record<SourceKind, string>>;
  };
}

const { evidence, locale, labels = {} } = Astro.props;
const statusClasses: Record<EvidenceStatus, string> = {
  official: 'border-emerald-500/40 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300',
  verified: 'border-emerald-500/40 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300',
  mixed: 'border-amber-500/40 bg-amber-500/10 text-amber-700 dark:text-amber-300',
  community: 'border-sky-500/40 bg-sky-500/10 text-sky-700 dark:text-sky-300',
  unconfirmed: 'border-border bg-muted text-muted-foreground',
};
const statusLabel = labels.statuses?.[evidence.status] ?? evidence.status;
---

<aside class="mt-6 rounded-lg border border-border bg-card p-4" aria-labelledby="evidence-title">
  <div class="flex flex-wrap items-center gap-2">
    <Icon name="lucide:shield-check" class="h-4 w-4 text-nav" />
    <h2 id="evidence-title" class="text-sm font-semibold text-foreground">
      {labels.title ?? 'Verification and sources'}
    </h2>
    <span
      class:list={[
        'rounded-full border px-2 py-0.5 text-xs font-medium',
        statusClasses[evidence.status],
      ]}
    >
      {statusLabel}
    </span>
    <span class="ml-auto text-xs text-muted-foreground">
      {labels.checkedAt ?? 'Checked'}: {
        evidence.checkedAt.toLocaleDateString(locale, { timeZone: 'UTC' })
      }
    </span>
  </div>

  <ul class="mt-3 grid gap-2 sm:grid-cols-2">
    {
      evidence.sources.map((source) => (
        <li>
          <a
            href={source.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-start gap-2 rounded-md border border-border px-3 py-2 text-sm transition hover:border-nav/50 hover:text-nav"
          >
            <Icon name="lucide:external-link" class="mt-0.5 h-3.5 w-3.5 shrink-0" />
            <span class="min-w-0">
              <span class="block font-medium leading-snug">{source.label}</span>
              <span class="mt-0.5 block text-xs text-muted-foreground">
                {labels.sourceKinds?.[source.kind] ?? source.kind}
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</aside>
